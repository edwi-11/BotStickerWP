# ================= WHATSAPP =================
# Número con código de país, sin "+", para vincular con código en vez de QR (opcional).
# Ej: 905310254681
WA_PAIRING_NUMBER=

# Carpeta donde Baileys guarda la sesión (se crea sola). No la borres o perderás el vínculo.
WA_AUTH_DIR=./auth

# ================= LÍMITES =================
# Tamaño máximo de imagen/video que se acepta descargar y convertir.
MAX_DOWNLOAD_MB=20
# Archivos máximos por minuto que se procesan por chat (protege el número).
RATE_LIMIT_PER_MIN=6
# Tiempo máximo (ms) que se espera a que termine la conversión antes de abortarla.
CONVERT_TIMEOUT_MS=120000
# Tiempo máximo (ms) para descargar el contenido de un enlace que envía un usuario.
LINK_TIMEOUT_MS=45000

# ================= VIDEOS DE TIKTOK / YOUTUBE =================
# Peso maximo (MB) del video que se envia a WhatsApp (WhatsApp acepta ~16 MB).
VIDEO_MAX_MB=16
# Duracion maxima (minutos) que se acepta descargar.
VIDEO_MAX_MINUTES=10
# Tiempo (segundos) que el usuario tiene para responder 1, 2 o 3.
CHOICE_TIMEOUT_SEC=120
# Tiempo maximo (ms) de la descarga con yt-dlp.
YTDLP_TIMEOUT_MS=180000
# En grupos: true = al enviar SOLO un enlace de TikTok/YouTube el bot pregunta 1/2/3.
#            false = solo pregunta si escriben "/s <enlace>".
GROUP_LINK_PROMPT=true
# Binario de yt-dlp (cambialo si no esta en el PATH).
YTDLP_BIN=yt-dlp

# ================= STICKERS =================
# Que tan alargado puede quedar el sticker (lado largo / lado corto). Lo que sobra se recorta.
#   1    -> siempre cuadrado exacto
#   1.2  -> casi cuadrado (recomendado); una imagen ya cuadrada no se recorta
#   99   -> no recorta nunca (deja franjas transparentes, como antes)
STICKER_MAX_RATIO=1.2

# ================= RUTAS / LOGS =================
TEMP_DIR=./temp
LOG_LEVEL=info
# Nivel de log de Baileys (warn muestra errores de sesion/cifrado; debug para diagnosticar).
BAILEYS_LOG_LEVEL=warn

# Binario de Python a usar para el conversor (cambia si tu entorno usa "python" en vez de "python3").
PYTHON_BIN=python3
