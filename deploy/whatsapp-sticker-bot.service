[Unit]
Description=Bot de WhatsApp para crear stickers
After=network-online.target
Wants=network-online.target

[Service]
User=stickerbot
WorkingDirectory=/opt/whatsapp_sticker_bot
EnvironmentFile=/opt/whatsapp_sticker_bot/.env
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/whatsapp_sticker_bot

[Install]
WantedBy=multi-user.target
